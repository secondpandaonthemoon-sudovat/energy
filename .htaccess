Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On

# Preserve Bearer authentication with Apache CGI/FastCGI (XAMPP and hosting).
CGIPassAuth On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# API is routed to PHP
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

# Protect private folders
RewriteRule ^(config|data)/ - [F,L]

# Existing files/folders are served directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React admin route / client-side routes
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
